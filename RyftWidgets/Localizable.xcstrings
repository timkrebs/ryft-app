  "strings" : {
    "%@, not scored" : {
      "comment" : "Widget VoiceOver: a score that is missing (not scored), after its name (Recovery, Sleep, Strain).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, noch nicht bewertet"
          }
        }
      }
    },
    "%lld of %lld" : {
      "comment" : "Widget, lock screen rectangle: nights counted of the nights the baselines need, e.g. 3 of 7. Keep the no-break spaces.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$lld"
          }
        }
      }
    },
