// Production values, baked into every build. Committed on purpose: all three are
// publishable. The platform's RLS and revoked grants mean the Supabase Data API
// exposes nothing, and the app only talks to Supabase Auth.
//
// Fill in once (Supabase → Project Settings → API / API Keys):
//   <project-ref>  the ref in https://<ref>.supabase.co
//   publishable    sb_publishable_… (or the legacy anon key)
//
// `//` starts a comment in xcconfig files, hence https:/$()/host.
// Info.plist exposes them as RyftAPIURL, RyftSupabaseURL, RyftSupabasePublishableKey.
// Config/Debug.xcconfig (git-ignored) includes this file and may override any of them.

RYFT_API_URL = https:/$()/api.ryftapp.de
RYFT_SUPABASE_URL = https:/$()/ydgbemufggwnegbnjhkm.supabase.co
RYFT_SUPABASE_PUBLISHABLE_KEY = sb_publishable_naDyZ9ZtrYe_VDcNx62sTw_KzybSx4r

// Info.plist is preprocessed so App Transport Security stays HTTPS-only unless a
// configuration opts in (Debug.xcconfig: RYFT_LOCAL_NETWORKING for a LAN compose stack).
// -traditional keeps the `//` in the plist's DOCTYPE URL from being read as a comment.
INFOPLIST_PREPROCESS = YES
INFOPLIST_OTHER_PREPROCESSOR_FLAGS = -traditional

// Warnings are errors when CI says so (`RYFT_STRICT_WARNINGS=YES` on the xcodebuild
// command line). Setting SWIFT_TREAT_WARNINGS_AS_ERRORS there directly would also hit
// the Swift packages, which build with -suppress-warnings and refuse both flags; this
// file only reaches our own targets.
RYFT_STRICT_WARNINGS = NO
SWIFT_TREAT_WARNINGS_AS_ERRORS = $(RYFT_STRICT_WARNINGS)
