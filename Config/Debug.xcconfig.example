// Debug build settings. Copy to Config/Debug.xcconfig (git-ignored) and fill in:
//
//   cp Config/Debug.xcconfig.example Config/Debug.xcconfig
//
// `//` starts a comment in xcconfig files, so URLs are written as https:/$()/host.
// project.yml copies these values into Info.plist (RyftSupabaseURL, …) and
// SupabaseConfig / Settings read them from there.

// Supabase → Project Settings → API: Project URL and the anon (publishable) key.
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// Default RYFT platform URLs on a fresh install (still editable in Profile → Account).
// With docker compose use your Mac's LAN IP: http:/$()/192.168.1.20:8082 and :8081.
// Leave RYFT_INGEST_URL empty when ingest and api share one host behind the Ingress.
RYFT_API_URL = https:/$()/ryft.example.com
RYFT_INGEST_URL =
