// Debug build settings. Copy to Config/Debug.xcconfig (git-ignored):
//
//   cp Config/Debug.xcconfig.example Config/Debug.xcconfig
//
// Starts from the production values; uncomment to point Debug builds elsewhere,
// e.g. a docker compose platform (`//` is a comment, hence https:/$()/host).

#include "Production.xcconfig"

// RYFT_API_URL = http:/$()/192.168.1.20:8082
// RYFT_SUPABASE_URL = https:/$()/<other-project-ref>.supabase.co
// RYFT_SUPABASE_PUBLISHABLE_KEY = <other publishable key>
//
// A compose platform runs AUTH_MODE=apikey: turn on Profile → Developer → API key mode
// and set the ingest override (:8081) there too. Compose serves ingest on its own port.
