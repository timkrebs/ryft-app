        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Basiswerte werden noch ermittelt."
          }
        }
      }
    },
    "Your birth year gives an estimate of your maximum heart rate, which strain and heart-rate zones are measured against. RYFT keeps only the year." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anhand deines Geburtsjahrs schätzt RYFT deine maximale Herzfrequenz. Sie dient als Bezugswert für Belastung und Herzfrequenzzonen. RYFT speichert nur das Jahr."
          }
        }
      }
    },
    "Your choice" : {
      "comment" : "Training import, step 4: a row's status.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Auswahl"
          }
        }
