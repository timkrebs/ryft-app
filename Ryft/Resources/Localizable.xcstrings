          }
        }
      }
    },
    "The number is your own weight. RYFT logs the sets without added weight and notes %@ as your body weight for the workout." : {
      "comment" : "Training import, step 4: the body-weight option.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
