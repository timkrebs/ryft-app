    "This workout is in another picked file too and is imported once" : {
      "comment" : "Import warning, after \"Line N\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Training steckt in mehreren gewählten Dateien und wird einmal importiert."
          }
        }
      }
    },
    "threshold" : {
