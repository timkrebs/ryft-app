    },
    "You can sign in to this account with:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Konto stehen folgende Anmeldemethoden zur Verfügung:"
          }
        }
      }
    },
    "You must be at least 16 to use RYFT." : {
      "comment" : "Consent screen: the minimum age (Art. 8 GDPR, Germany).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst mindestens 16 Jahre alt sein, um RYFT zu nutzen."
          }
        }
      }
    },
    "You review the requested permissions when you link your provider account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Verbinden des Anbieterkontos kannst du die angeforderten Berechtigungen prüfen."
          }
        }
      }
    },
    "You're in the middle of another import. Opening this file starts over." : {
      "comment" : "Training import E8.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderer Import ist bereits vorbereitet. Wenn du diese Datei öffnest, beginnst du von vorn."
          }
        }
      }
    },
    "You're offline and RYFT hasn't loaded your settings yet, so this shows the default. You can change it once you're back online." : {
      "comment" : "Body setting editors, offline with no account on this iPhone: the value is the default, Save is off.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline und RYFT hat deine Einstellungen noch nicht geladen. Deshalb siehst du den Standardwert. Sobald du wieder online bist, kannst du ihn ändern."
          }
        }
      }
    },
    "You're offline, so nothing was rescored. Try again when you're back online." : {
      "comment" : "Body setting editors and Profile: Rescore the last 90 days, offline.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Es wurden keine Werte neu berechnet. Versuche es erneut, sobald du wieder online bist."
          }
        }
      }
    },
    "You're offline, so RYFT couldn't check for duplicates yet." : {
      "comment" : "Training import, step 5: the duplicate check needs the network.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. RYFT konnte noch nicht nach doppelten Trainings suchen."
          }
        }
      }
    },
    "You're offline, so this wasn't saved. Try again when you're back online." : {
      "comment" : "Settings (Notifications, the body-setting editors) and Journal: nothing was sent because the iPhone is offline, so nothing changed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Versuche es erneut, sobald du wieder online bist."
          }
        }
      }
    },
    "You're offline. Connect to the internet to update Nutrition." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Stelle eine Internetverbindung her, um deine Ernährungsdaten zu aktualisieren."
          }
        }
      }
    },
    "You're offline. RYFT can't be reached, but the check reads Apple Health on this iPhone. Your data syncs when you're back online." : {
      "comment" : "Check sync without a connection: the check runs on the iPhone; uploads wait for the connection.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. RYFT ist nicht erreichbar, der Check liest aber Apple Health auf diesem iPhone. Deine Daten werden synchronisiert, sobald du wieder online bist."
          }
        }
      }
    },
    "You're offline. Syncing again works when you're back online." : {
      "comment" : "Sync details: under the actions while offline; Sync last 3 days again and Full resync are disabled.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Sobald du wieder online bist, kannst du erneut synchronisieren."
          }
        }
      }
    },
    "You're offline. Your import is kept on this iPhone and continues when you're back online." : {
      "comment" : "Training import I6.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Der Import bleibt auf diesem iPhone gespeichert und wird fortgesetzt, sobald du wieder online bist."
          }
        }
      }
    },
    "You're signed out, so this report can't be sent. Your message is kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
