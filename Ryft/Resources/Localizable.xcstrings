    "It's marked “added by you”. If your tracker records this night later, RYFT uses the tracker's data instead." : {
      "comment" : "Add sleep: the night is marked as typed in; the tracker's wins.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Eintrag ist als „von dir hinzugefügt“ markiert. Erfasst dein Tracker diese Nacht später, nutzt RYFT stattdessen seine Daten."
          }
        }
      }
    },
    "It's removed from RYFT and your strain for the day is recalculated." : {
      "comment" : "Delete a manual activity: what happens.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wird aus RYFT entfernt und deine Tagesbelastung wird neu berechnet."
