          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT hat diesen Eintrag nicht angenommen."
          }
        }
      }
    },
    "RYFT doesn't see any %@ in Apple Health. Either RYFT isn't allowed to read it, or %@ isn't writing it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT findet in Apple Health keine Daten für %1$@. Entweder darf RYFT sie nicht lesen, oder %2$@ schreibt sie nicht."
          }
        }
      }
    },
    "RYFT doesn't sync or score your health data until you agree." : {
      "localizations" : {
