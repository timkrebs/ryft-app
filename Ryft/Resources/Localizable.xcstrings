{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {},
    "%1$@, %2$@, on a scale from 0 to 21. The moderate range is 10 to 14." : {
      "comment" : "VoiceOver on Today's strain tile: the value (12.4), its band (Moderate strain), the scale and the ruler's band.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@, auf einer Skala von 0 bis 21. Der moderate Bereich liegt zwischen 10 und 14."
          }
        }
      }
    },
    "%@ accepted" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ akzeptiert"
          }
        }
      }
    },
    "%@ and %@" : {
      "comment" : "Training import: two counts, e.g. 1 plan and 12 workouts.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ und %@"
          }
        }
      }
    },
    "%@ asleep, %@ to %@, %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ geschlafen, von %2$@ bis %3$@, %4$@"
          }
        }
      }
    },
    "%@ doesn't share %@ with Apple Health." : {
      "comment" : "Under Today's gauge: the app doesn't write it to Apple Health. Args: app (Garmin Connect), one signal (HRV).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ teilt %2$@ nicht mit Apple Health."
          }
        }
      }
    },
    "%@ doesn't share HRV or resting heart rate with Apple Health." : {
      "comment" : "Under Today's gauge: the app writes neither to Apple Health. The argument is the app, e.g. Oura.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ teilt weder Herzfrequenzvariabilität noch Ruhepuls mit Apple Health."
          }
        }
      }
    },
    "%@ doesn't write to Apple Health, so nothing it records can reach RYFT. Your iPhone's own step count still does." : {
      "comment" : "Setup card of a tracker that writes nothing to Apple Health. The argument is its name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ schreibt keine Daten in Apple Health. Daher erhält RYFT keine Aufzeichnungen von dort. Die vom iPhone gezählten Schritte werden weiterhin erfasst."
          }
        }
      }
    },
    "%@ duplicates" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelte Einträge: %@"
          }
        }
      }
    },
    "%@ from %@" : {
