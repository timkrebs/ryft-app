    },
    "RYFT couldn't take that change. Try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT konnte diese Änderung nicht übernehmen. Versuch es später noch einmal."
          }
        }
      }
    },
    "RYFT couldn't take this report. Copy your message and try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT konnte diese Meldung nicht annehmen. Kopiere deine Nachricht und versuch es später erneut."
          }
        }
      }
    },
    "RYFT doesn't see any %@ in Apple Health. Either RYFT isn't allowed to read it, or %@ isn't writing it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT findet in Apple Health keine Daten für %1$@. Entweder darf RYFT sie nicht lesen, oder %2$@ schreibt sie nicht."
          }
        }
      }
    },
    "RYFT doesn't sync or score your health data until you agree." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT synchronisiert und bewertet deine Gesundheitsdaten erst nach deiner Zustimmung."
          }
        }
      }
    },
    "RYFT hasn't asked for Health access yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT hat noch nicht um Zugriff auf Health gebeten."
          }
        }
      }
    },
    "RYFT is busy right now. Your data is safe; try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT ist gerade ausgelastet. Deine Daten sind sicher, versuch es gleich noch einmal."
          }
        }
      }
    },
    "RYFT is invite-only during the beta. Enter your invite code to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Beta ist RYFT nur mit Einladung nutzbar. Gib deinen Einladungscode ein, um weiterzumachen."
          }
        }
      }
    },
    "RYFT is invite-only during the beta. The person who invited you has a code for you, like RYFT-7K3M-QX9P." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Beta ist RYFT nur mit Einladung nutzbar. Die Person, die dich eingeladen hat, hat einen Code für dich, etwa RYFT-7K3M-QX9P."
          }
        }
      }
    },
    "RYFT needs %@ writing to Apple Health, and Apple Health access. Profile → Devices & sync shows how to set up %@." : {
      "comment" : "No Health data hint, with the chosen tracker's app (both arguments).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT braucht Daten, die %1$@ in Apple Health schreibt, und Zugriff auf Apple Health. Unter Profil → Geräte & Sync siehst du, wie du %2$@ einrichtest."
          }
        }
      }
    },
    "RYFT needs your consent before it can sync your health data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT braucht deine Einwilligung, bevor es deine Gesundheitsdaten synchronisieren kann."
          }
        }
      }
    },
    "RYFT only uses this to show you setup steps and to check that your data arrives." : {
      "comment" : "Footnote of the tracker picker in Devices & sync.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT nutzt das nur, um dir Einrichtungsschritte zu zeigen und zu prüfen, ob deine Daten ankommen."
          }
        }
      }
    },
    "RYFT only uses this to show you setup steps and to check that your data arrives. You can change it any time in Profile → Devices & sync." : {
      "comment" : "Footnote of What do you wear? in onboarding.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT nutzt das nur, um dir Einrichtungsschritte zu zeigen und zu prüfen, ob deine Daten ankommen. Du kannst es jederzeit unter Profil → Geräte & Sync ändern."
          }
        }
      }
    },
    "RYFT reads whatever your tracker saves to Apple Health. What arrives depends on the tracker, so the check shows exactly what it is." : {
      "comment" : "Setup card of Other.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT liest, was dein Gerät in Apple Health speichert. Was ankommt, hängt vom Gerät ab; die Prüfung zeigt dir genau, was es ist."
          }
        }
      }
    },
    "RYFT sent an answer this version of the app can't read." : {
      "comment" : "Error when the platform's answer can't be decoded (status 200 and request ID are kept in Details).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT hat eine Antwort geschickt, die diese App-Version nicht lesen kann."
          }
        }
      }
    },
    "RYFT stops syncing and scoring your health data. Nothing is deleted: your scores stay readable, and you can export your data or delete your account at any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT synchronisiert und bewertet deine Gesundheitsdaten nicht mehr. Gelöscht wird nichts: Deine Werte bleiben lesbar, und du kannst deine Daten jederzeit exportieren oder dein Konto löschen."
          }
        }
      }
    },
    "RYFT takes a baseline between 4 and 12 hours." : {
