          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten wurden noch nicht abgeglichen"
          }
        }
      }
    },
    "SYNC_STALE_LOCAL_2_BODY" : {
      "comment" : "The second local \"not syncing\" notification's body (sync.stale.2).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's been about three days since RYFT last synced. Open RYFT to catch up on your scores."
