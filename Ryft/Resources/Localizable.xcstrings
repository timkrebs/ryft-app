    "SYNC_STALE_LOCAL_1_BODY" : {
      "comment" : "The local \"not syncing\" notification's body (sync.stale.1). No hour count: it can fire 19 to about 30 hours after the last sync.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open RYFT to bring it up to date. Closing RYFT from the app switcher can stop background sync."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne RYFT, um deine Daten abzugleichen. Wenn du RYFT im App-Umschalter schließt, kann der Abgleich im Hintergrund stoppen."
          }
        }
      }
    },
    "SYNC_STALE_LOCAL_1_TITLE" : {
      "comment" : "The local \"not syncing\" notification (sync.stale.1, about 20 hours after the last successful sync, 09:00–21:00): its title.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data hasn't synced"
