          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT vergisst, wie es importierte Übungen zugeordnet hat."
          }
        }
      }
    },
    "RYFT forgets what it read from the file and your choices here. The file itself is not changed." : {
      "comment" : "Training import: the cancel confirmation's message (N1).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
