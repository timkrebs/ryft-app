      }
    },
    "RYFT can't be reached right now. Your connection looks fine, so this isn't on your side." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT ist gerade nicht erreichbar. Deine Verbindung scheint in Ordnung zu sein, es liegt also nicht an dir."
          }
        }
      }
    },
    "RYFT can't read %@ data on iPhone today." : {
      "comment" : "A tracker that writes nothing to Apple Health, on its setup card and in Check sync. The argument is its name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT kann die Daten von %@ auf dem iPhone derzeit nicht lesen."
          }
        }
      }
    },
    "RYFT can't read these columns yet, so this exercise's sets were skipped" : {
      "comment" : "Import warning, after \"Line N\": a set table with other columns than weight and reps.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RYFT kann diese Spalten noch nicht lesen, daher wurden die Sätze dieser Übung übersprungen"
          }
