    "%@ doesn't share %@ with Apple Health." : {
      "comment" : "Under Today's gauge: the app doesn't write it to Apple Health. Args: app (Garmin Connect), one signal (HRV).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sendet %2$@ nicht an Apple Health."
          }
        }
      }
    },
    "%@ doesn't share HRV or resting heart rate with Apple Health." : {
      "comment" : "Under Today's gauge: the app writes neither to Apple Health. The argument is the app, e.g. Oura.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sendet weder HRV noch Ruhepuls an Apple Health."
          }
        }
      }
    },
    "%@ doesn't write to Apple Health, so nothing it records can reach RYFT. Your iPhone's own step count still does." : {
      "comment" : "Setup card of a tracker that writes nothing to Apple Health. The argument is its name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ schreibt nicht in Apple Health, deshalb kann nichts davon RYFT erreichen. Die Schritte deines iPhones kommen weiterhin an."
          }
        }
      }
    },
