      }
    },
    "Your account is being deleted. This activity is deleted with it." : {
      "comment" : "Activity detail: uploads stopped because the account is being deleted.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto wird gelöscht. Diese Aktivität wird dabei ebenfalls gelöscht."
          }
        }
      }
    },
    "Your baseline is yours to set. The top-ups follow yesterday's strain and your sleep debt; a nap lowers the next night's need." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deinen Grundschlafbedarf legst du fest. Die Belastung von gestern und dein Schlafrückstand erhöhen den Bedarf. Ein Nickerchen senkt ihn für die nächste Nacht."
          }
        }
      }
    },
    "You'll get" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erhältst"
          }
        }
      }
    },
    "Your baselines are being recalculated." : {
      "comment" : "Today's sentence in row D when today's readiness is shown.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Basiswerte werden neu berechnet."
          }
        }
